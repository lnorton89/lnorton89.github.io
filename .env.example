# GitHub username whose public activity the site displays.
GH_USERNAME=your-github-username

# Optional. A classic PAT with no scopes (public data only) or `read:user` if
# you want the real contribution calendar. Without this the build still works
# but falls back to an approximate commit-velocity chart instead of the real
# calendar, since that endpoint is GraphQL + auth-only.
GH_PAT=

# Leave empty for a user page (yourname.github.io). Set to /repo-name for a
# project page (yourname.github.io/repo-name) — the deploy workflow sets this
# automatically from the repo name.
NEXT_PUBLIC_BASE_PATH=

# Optional canonical site URL (defaults to https://lnorton89.github.io).
NEXT_PUBLIC_SITE_URL=https://lnorton89.github.io
